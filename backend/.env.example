# Copy this file to backend/.env for local development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRAINING_ENABLED=false

# Neo4j AuraDB (required for graph persistence)
NEO4J_URI=bolt+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password
NEO4J_DATABASE=neo4j

# Neo4j Test Instance (for integration tests only — NEVER use production)
NEO4J_TEST_URI=
NEO4J_TEST_USERNAME=
NEO4J_TEST_PASSWORD=
NEO4J_TEST_DATABASE=neo4j

# Brevo API Settings (for alert notifications)
BREVO_API_KEY=
BREVO_FROM_NAME=GeoSentinel AI
BREVO_FROM_EMAIL=
ALERT_TO_EMAIL=
